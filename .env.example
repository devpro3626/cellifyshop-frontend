# ── Store contact ─────────────────────────────────────────────
# WhatsApp number with country code. Spaces and "+" are ignored.
NEXT_PUBLIC_WHATSAPP_NUMBER=971562361397
# Optional: how the number is shown on the site (defaults to +<number>)
NEXT_PUBLIC_WHATSAPP_DISPLAY=+971 56 236 1397

# Public address of the store, used for product links sent on WhatsApp.
# Use http://localhost:3000 in development and your real domain in production.
NEXT_PUBLIC_SITE_URL=https://cellifyshop.com

# ── Admin portal ──────────────────────────────────────────────
# Password for /admin (required in production)
ADMIN_PASSWORD=change-me
# Optional: separate secret used to sign admin sessions
ADMIN_SECRET=
